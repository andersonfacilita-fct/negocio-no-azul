---
export interface Props {
  productId?: string;
}
const { productId = 'I105499750V' } = Astro.props;
const checkoutUrl = `https://pay.hotmart.com/${productId}?checkoutMode=2`;
---

<div
  id="checkout-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-900/60 backdrop-blur-[2px] p-3 sm:p-6 md:p-10"
  aria-hidden="true"
  role="dialog"
>
  <div class="relative w-full max-w-md sm:max-w-lg h-[85vh] sm:h-[80vh] max-h-[720px] bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col">
    <div class="flex items-center justify-between px-3 py-2 bg-navy-900 text-white border-b border-navy-800">
      <div class="flex items-center gap-2">
        <span class="text-teal-400 text-sm">🔒</span>
        <span class="font-bold text-xs sm:text-sm">Checkout seguro · Hotmart</span>
      </div>
      <button
        id="checkout-modal-close"
        aria-label="Fechar checkout"
        class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition text-white text-lg font-bold leading-none"
      >×</button>
    </div>
    <iframe
      id="checkout-iframe"
      src="about:blank"
      title="Checkout Hotmart"
      class="flex-1 w-full border-0"
      allow="payment"
    ></iframe>
  </div>
</div>

<script is:inline define:vars={{ checkoutUrl }}>
  (function () {
    var modal = document.getElementById('checkout-modal');
    var iframe = document.getElementById('checkout-iframe');
    var closeBtn = document.getElementById('checkout-modal-close');
    if (!modal || !iframe || !closeBtn) return;

    function openModal() {
      iframe.setAttribute('src', checkoutUrl);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(function () { iframe.setAttribute('src', 'about:blank'); }, 200);
    }

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    document.querySelectorAll('[data-cta="checkout"]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        openModal();
      });
    });
  })();
</script>
