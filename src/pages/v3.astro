  <script is:inline>
    (function () {
      var STORAGE_KEY = 'na_v3_quiz';
      var SESSION_ID = (function () {
        try {
          var sid = sessionStorage.getItem('na_v3_sid');
          if (!sid) {
            sid = 'qz_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10);
            sessionStorage.setItem('na_v3_sid', sid);
          }
          return sid;
        } catch (e) { return 'qz_' + Date.now(); }
      })();

      // restaura estado se já fez parte do quiz
      var answers = {};
      try {
        var saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        if (saved && saved.session_id === SESSION_ID && saved.answers) {
          answers = saved.answers;
        }
      } catch (e) {}

      function persist() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({
            session_id: SESSION_ID,
            answers: answers,
            updated_at: new Date().toISOString()
          }));
        } catch (e) {}
      }

      // Track no Meta Pixel + UTMfy (analytics agregado)
      function track(eventName, data) {
        try {
          if (window.fbq) window.fbq('trackCustom', eventName, data || {});
        } catch (e) {}
        try {
          // log também via beacon pra debug (não falha se cors)
          if (navigator.sendBeacon) {
            var payload = JSON.stringify({
              event: eventName,
              session_id: SESSION_ID,
              data: data || {},
              ts: Date.now()
            });
            navigator.sendBeacon('https://painel.facilitaportoes.shop/api/quiz-tracker', payload);
          }
        } catch (e) {}
      }

      var STEPS = ['step-0','step-1','step-2','step-3','step-4','step-5'];

      function show(id) {
        document.querySelectorAll('.quiz-step').forEach(function (s) { s.classList.add('hidden'); });
        var el = document.getElementById(id);
        if (el) {
          el.classList.remove('hidden');
          window.scrollTo({top: 0, behavior: 'instant'});
        }
      }

      function nextStep(n) {
        if (n === 'result') {
          show('step-loading');
          // simula processamento (sensação de cálculo personalizado)
          setTimeout(renderResult, 2200);
          return;
        }
        show('step-' + n);
      }

      // bindings
      document.querySelectorAll('[data-quiz-next]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = btn.getAttribute('data-quiz-next');
          if (next === '1') {
            // Lead clicou em "Começar Diagnóstico"
            track('QuizStarted', { session_id: SESSION_ID });
          }
          nextStep(next);
        });
      });
      document.querySelectorAll('[data-quiz-back]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          nextStep(btn.getAttribute('data-quiz-back'));
        });
      });
      document.querySelectorAll('[data-quiz-answer]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var q = btn.getAttribute('data-question');
          var v = btn.getAttribute('data-value');
          answers[q] = v;
          persist();
          // tracking de cada resposta — Anderson vê funil completo
          track('QuizStep', { question: q, value: v, session_id: SESSION_ID });
          var next = btn.getAttribute('data-next');
          // micro-delay pra animação de feedback
          btn.classList.add('ring-4', 'ring-teal-400', 'bg-teal-100');
          setTimeout(function () { nextStep(next); }, 250);
        });
      });

      // lógica de diagnóstico personalizado
      function renderResult() {
        // estimativa de leak por faixa de faturamento × dor
        var leakMap = {
          ate10k: { base: 800, label: 'micro-negócio' },
          '10k_30k': { base: 2400, label: 'pequeno negócio' },
          '30k_80k': { base: 6200, label: 'negócio em crescimento' },
          '80k_mais': { base: 11500, label: 'negócio estruturado' }
        };
        var dorMap = {
          sem_sobra: { mult: 1.0, headline: 'Você vende, mas perde quase tudo no caminho', actions: [
            'Identifique os 5 ralos da semana: fornecedor + comissão + cartão + retiradas + impostos atrasados',
            'Faça a separação PF/PJ — 80% do problema é mistura',
            'Defina um pró-labore fixo (você não é caixa)',
            'Calcule o lucro REAL semanal (não mensal — semanal é mais visível)'
          ]},
          sem_clareza: { mult: 1.1, headline: 'Falta clareza — isso custa em média 8-12% do seu faturamento', actions: [
            'Mapeie todas as contas em 3 categorias: fixo, variável, eventual',
            'Use a planilha A.Z.U.L. (vem incluída) — abra e jogue tudo de uma vez',
            'Identifique os "compromissos invisíveis" (assinaturas, taxas, juros)',
            'Em 7 dias você já tem visibilidade do mês inteiro'
          ]},
          muitas_horas: { mult: 0.9, headline: 'Você é o gargalo. O dinheiro vaza porque você não tem energia pra olhar', actions: [
            'Delegue 1 tarefa repetitiva HOJE (você não precisa fazer tudo)',
            'Configure o "Caixa do Domingo" — 30 min por semana pra revisar',
            'Identifique o que só você consegue fazer (e foque nisso)',
            'O método A.Z.U.L. é feito pra dono que tem 30 min por semana, não 30 horas'
          ]},
          misto_pf_pj: { mult: 1.2, headline: 'Misturar PF e PJ é o ralo mais comum — e mais caro', actions: [
            'Abra hoje uma conta PJ separada (pode ser Nubank PJ, gratuita)',
            'Defina seu pró-labore: valor X por mês, fixo, sai todo dia 5',
            'Toda compra pessoal: cartão da PF. Toda compra do negócio: cartão da PJ',
            'Em 30 dias seu lucro real aparece — quase sempre é maior do que parece'
          ]}
        };
        var urgenciaMap = {
          urgente: 1.15,
          mes: 1.0,
          '90dias': 0.85
        };
        var ramoLabel = {
          comercio: 'Comércio',
          servico: 'Serviços',
          alimentacao: 'Alimentação',
          outro: 'seu setor'
        };

        var leakCfg = leakMap[answers.faturamento] || leakMap['10k_30k'];
        var dorCfg = dorMap[answers.dor] || dorMap.sem_sobra;
        var urgMult = urgenciaMap[answers.urgencia] || 1;

        var leak = Math.round(leakCfg.base * dorCfg.mult * urgMult);
        var leakYearly = leak * 12;

        document.getElementById('result-leak-value').textContent = 'R$ ' + leak.toLocaleString('pt-BR');
        document.getElementById('result-leak-yearly').textContent = 'R$ ' + leakYearly.toLocaleString('pt-BR');
        document.getElementById('result-leak-context').textContent =
          'média de ' + leakCfg.label + ' em ' + ramoLabel[answers.ramo] + ' com seu perfil de dor';

        document.getElementById('result-headline').textContent = dorCfg.headline;

        var expl = document.getElementById('result-explanation');
        expl.innerHTML =
          '<p>Pelo seu perfil de <strong>' + ramoLabel[answers.ramo] + '</strong> faturando na sua faixa, ' +
          'o vazamento médio é de <strong>R$ ' + leak.toLocaleString('pt-BR') + '/mês</strong> — dinheiro que entra ' +
          'mas some antes de virar lucro.</p>' +
          '<p>A boa notícia: o método <strong>A.Z.U.L.</strong> foi montado exatamente pra recuperar esses ' +
          'R$ ' + leak.toLocaleString('pt-BR') + ' em <strong>até 7 dias de aplicação</strong>. Sem precisar vender mais. ' +
          'Sem trabalhar mais horas.</p>';

        var ol = document.getElementById('result-actions');
        ol.innerHTML = dorCfg.actions.map(function (a, i) {
          return '<li class="flex items-start gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full bg-gold-400 text-navy-900 font-extrabold text-sm flex items-center justify-center">' + (i+1) + '</span><span class="text-sm sm:text-base text-white leading-relaxed pt-0.5">' + a + '</span></li>';
        }).join('');

        // adiciona UTMs Hotmart do perfil no checkout URL
        // sck/xcod são tracking codes que Hotmart guarda no banco da venda
        var checkoutBtn = document.getElementById('quiz-checkout-btn');
        var profile = (answers.ramo||'na') + '_' + (answers.faturamento||'na') + '_' + (answers.dor||'na') + '_' + (answers.urgencia||'na');
        try {
          checkoutBtn.setAttribute('data-quiz-profile', profile);
          checkoutBtn.setAttribute('data-quiz-leak', String(leak));
        } catch (e) {}

        // dispara QuizCompleted com payload completo — Anderson vê tudo no Events Manager
        // + Custom Audience por perfil + analytics próprio via webhook
        track('QuizCompleted', {
          session_id: SESSION_ID,
          ramo: answers.ramo,
          faturamento: answers.faturamento,
          dor: answers.dor,
          tentou: answers.tentou,
          urgencia: answers.urgencia,
          leak_estimate: leak,
          leak_yearly: leakYearly,
          profile: profile
        });

        // intercepta click no checkout pra adicionar UTMs Hotmart antes do modal abrir
        if (checkoutBtn && !checkoutBtn._quizBound) {
          checkoutBtn._quizBound = true;
          checkoutBtn.addEventListener('click', function () {
            track('QuizCheckoutClick', { profile: profile, leak: leak });
            // injeta UTMs Hotmart no iframe que vai abrir
            try {
              var iframe = document.getElementById('checkout-iframe');
              if (iframe) {
                // observer: quando src mudar pro checkout, adiciona sck+xcod
                var obs = new MutationObserver(function (muts) {
                  muts.forEach(function (m) {
                    if (m.attributeName === 'src') {
                      var src = iframe.getAttribute('src');
                      if (src && src.indexOf('pay.hotmart.com') !== -1 && src.indexOf('sck=') === -1) {
                        var sep = src.indexOf('?') === -1 ? '?' : '&';
                        iframe.setAttribute('src', src + sep + 'sck=' + encodeURIComponent(profile) + '&xcod=' + encodeURIComponent('quiz_' + profile));
                      }
                    }
                  });
                });
                obs.observe(iframe, { attributes: true });
              }
            } catch (e) {}
          }, true);
        }

        // marca como completo pra retomar
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({
            session_id: SESSION_ID,
            answers: answers,
            profile: profile,
            leak_estimate: leak,
            completed_at: new Date().toISOString()
          }));
        } catch (e) {}

        // revela landing completa + barra escassez + footer (UX Maxxima: pós-resultado)
        var scarcity = document.getElementById('scarcity-wrapper');
        var fullLanding = document.getElementById('full-landing');
        var footerWrap = document.getElementById('footer-wrapper');
        if (scarcity) scarcity.classList.remove('hidden');
        if (fullLanding) fullLanding.classList.remove('hidden');
        if (footerWrap) footerWrap.classList.remove('hidden');

        show('step-result');
      }

      // retake quiz
      document.getElementById('quiz-retake')?.addEventListener('click', function () {
        answers = {};
        show('step-0');
      });
    })();
  </script>
