---
// Landing V3 — Quiz-first + landing Maxxima completa
// Acesso: negocionoazul.facilitaportoes.shop/v3
// Fluxo: 5 perguntas → diagnóstico personalizado → landing completa (Maxxima UX)
// Personalização passa via sck/xcod pro checkout Hotmart pra atribuição.

import Layout from '../layouts/Layout.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
import ProblemAgitation from '../components/ProblemAgitation.astro';
import MethodAzul from '../components/MethodAzul.astro';
import WhatsIncluded from '../components/WhatsIncluded.astro';
import ForWho from '../components/ForWho.astro';
import PriceOffer from '../components/PriceOffer.astro';
import FAQ from '../components/FAQ.astro';
import About from '../components/About.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import CaseStudyV2 from '../components/v2/CaseStudyV2.astro';
import ScarcityBar from '../components/v2/ScarcityBar.astro';
import SpreadsheetShowcase from '../components/v2/SpreadsheetShowcase.astro';
---

<Layout
  title="Quanto dinheiro está vazando do seu negócio? — Diagnóstico em 90 segundos"
  description="Responda 5 perguntas e descubra em 90 segundos quanto dinheiro está vazando do seu negócio agora — e como recuperar em 7 dias."
>
  <!-- Barra fixa de escassez (só aparece após o quiz, JS controla) -->
  <div id="scarcity-wrapper" class="hidden">
    <ScarcityBar />
  </div>

  <main class="min-h-screen bg-gradient-to-br from-navy-50 via-white to-teal-50">

    <!-- ETAPA 0: HOOK + INICIAR -->
    <section id="step-0" class="quiz-step min-h-[100vh] flex items-center justify-center px-5 py-12">
      <div class="max-w-3xl text-center">
        <div class="inline-block text-xs sm:text-sm font-bold text-teal-700 uppercase tracking-widest mb-5 px-4 py-1.5 bg-teal-100 rounded-full">
          🎯 Diagnóstico Negócio no Azul · 90 segundos
        </div>
        <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-extrabold text-navy-900 leading-[1.05] tracking-tight mb-5">
          Quanto dinheiro<br/>está <span class="text-red-600">vazando</span> do seu negócio<br/><span class="text-teal-700">agora mesmo</span>?
        </h1>
        <p class="text-base sm:text-xl text-navy-700 leading-relaxed mb-8 max-w-2xl mx-auto">
          Responda <strong class="text-navy-900">5 perguntas rápidas</strong> e descubra em 90 segundos:
        </p>
        <ul class="text-left max-w-md mx-auto space-y-2 mb-10 text-base sm:text-lg text-navy-800">
          <li class="flex items-start gap-2">
            <span class="text-teal-600 font-extrabold flex-shrink-0 mt-0.5">✓</span>
            Quanto você está perdendo por mês (em média do seu perfil)
          </li>
          <li class="flex items-start gap-2">
            <span class="text-teal-600 font-extrabold flex-shrink-0 mt-0.5">✓</span>
            Em qual dos 5 ralos o dinheiro está escapando
          </li>
          <li class="flex items-start gap-2">
            <span class="text-teal-600 font-extrabold flex-shrink-0 mt-0.5">✓</span>
            Plano de ação personalizado pro seu ramo
          </li>
        </ul>
        <button
          type="button"
          data-quiz-next="1"
          class="inline-flex items-center gap-3 bg-gradient-to-br from-teal-500 to-teal-700 hover:from-teal-400 hover:to-teal-600 text-white font-extrabold font-display text-base sm:text-xl uppercase tracking-wide px-8 sm:px-12 py-5 sm:py-6 rounded-2xl shadow-2xl shadow-teal-500/30 hover:-translate-y-1 transition-all cursor-pointer"
        >
          COMEÇAR DIAGNÓSTICO
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </button>
        <p class="text-xs text-navy-500 mt-6">
          🔒 100% anônimo · sem cadastro · sem enrolação
        </p>
      </div>
    </section>

    <!-- ETAPA 1: RAMO -->
    <section id="step-1" class="quiz-step hidden min-h-[100vh] flex items-center justify-center px-5 py-12">
      <div class="max-w-2xl w-full">
        <div class="text-center mb-3">
          <div class="text-xs font-bold text-navy-500 uppercase tracking-widest">Pergunta 1 de 5</div>
        </div>
        <div class="mb-8">
          <div class="h-1.5 bg-navy-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-teal-500 to-teal-600 transition-all duration-500" style="width:20%"></div>
          </div>
        </div>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-navy-900 leading-tight mb-3 text-center">
          Qual é o seu <span class="text-teal-600">ramo</span>?
        </h2>
        <p class="text-base sm:text-lg text-navy-600 text-center mb-8">
          Pra eu calcular o ralo médio do seu setor
        </p>
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <button type="button" data-quiz-answer data-question="ramo" data-value="comercio" data-next="2" class="quiz-option group bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl p-5 sm:p-6 text-center transition-all hover:-translate-y-1 cursor-pointer">
            <div class="text-4xl sm:text-5xl mb-2">🏪</div>
            <div class="font-bold text-navy-900 text-sm sm:text-base">Comércio</div>
            <div class="text-xs text-navy-500 mt-1">mercado · padaria · loja</div>
          </button>
          <button type="button" data-quiz-answer data-question="ramo" data-value="servico" data-next="2" class="quiz-option group bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl p-5 sm:p-6 text-center transition-all hover:-translate-y-1 cursor-pointer">
            <div class="text-4xl sm:text-5xl mb-2">🔧</div>
            <div class="font-bold text-navy-900 text-sm sm:text-base">Serviço</div>
            <div class="text-xs text-navy-500 mt-1">oficina · salão · estética</div>
          </button>
          <button type="button" data-quiz-answer data-question="ramo" data-value="alimentacao" data-next="2" class="quiz-option group bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl p-5 sm:p-6 text-center transition-all hover:-translate-y-1 cursor-pointer">
            <div class="text-4xl sm:text-5xl mb-2">🍔</div>
            <div class="font-bold text-navy-900 text-sm sm:text-base">Alimentação</div>
            <div class="text-xs text-navy-500 mt-1">restaurante · lanchonete</div>
          </button>
          <button type="button" data-quiz-answer data-question="ramo" data-value="outro" data-next="2" class="quiz-option group bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl p-5 sm:p-6 text-center transition-all hover:-translate-y-1 cursor-pointer">
            <div class="text-4xl sm:text-5xl mb-2">💼</div>
            <div class="font-bold text-navy-900 text-sm sm:text-base">Outro</div>
            <div class="text-xs text-navy-500 mt-1">MEI · consultor · venda</div>
          </button>
        </div>
        <div class="text-center mt-8">
          <button type="button" data-quiz-back="0" class="text-sm text-navy-500 hover:text-navy-700 font-semibold">← Voltar</button>
        </div>
      </div>
    </section>

    <!-- ETAPA 2: FATURAMENTO -->
    <section id="step-2" class="quiz-step hidden min-h-[100vh] flex items-center justify-center px-5 py-12">
      <div class="max-w-2xl w-full">
        <div class="text-center mb-3">
          <div class="text-xs font-bold text-navy-500 uppercase tracking-widest">Pergunta 2 de 5</div>
        </div>
        <div class="mb-8">
          <div class="h-1.5 bg-navy-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-teal-500 to-teal-600 transition-all duration-500" style="width:40%"></div>
          </div>
        </div>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-navy-900 leading-tight mb-3 text-center">
          Qual seu <span class="text-teal-600">faturamento mensal</span>?
        </h2>
        <p class="text-base sm:text-lg text-navy-600 text-center mb-8">
          Estimativa basta. Quanto entra no caixa em média.
        </p>
        <div class="space-y-3">
          <button type="button" data-quiz-answer data-question="faturamento" data-value="ate10k" data-next="3" class="quiz-option w-full flex items-center justify-between gap-3 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="font-bold text-navy-900 text-base sm:text-lg">Até R$ 10.000</span>
            <svg class="h-5 w-5 text-navy-400 group-hover:text-teal-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
          <button type="button" data-quiz-answer data-question="faturamento" data-value="10k_30k" data-next="3" class="quiz-option w-full flex items-center justify-between gap-3 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="font-bold text-navy-900 text-base sm:text-lg">R$ 10.000 a R$ 30.000</span>
            <svg class="h-5 w-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
          <button type="button" data-quiz-answer data-question="faturamento" data-value="30k_80k" data-next="3" class="quiz-option w-full flex items-center justify-between gap-3 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="font-bold text-navy-900 text-base sm:text-lg">R$ 30.000 a R$ 80.000</span>
            <svg class="h-5 w-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
          <button type="button" data-quiz-answer data-question="faturamento" data-value="80k_mais" data-next="3" class="quiz-option w-full flex items-center justify-between gap-3 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="font-bold text-navy-900 text-base sm:text-lg">Acima de R$ 80.000</span>
            <svg class="h-5 w-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
        </div>
        <div class="text-center mt-8">
          <button type="button" data-quiz-back="1" class="text-sm text-navy-500 hover:text-navy-700 font-semibold">← Voltar</button>
        </div>
      </div>
    </section>

    <!-- ETAPA 3: MAIOR DOR -->
    <section id="step-3" class="quiz-step hidden min-h-[100vh] flex items-center justify-center px-5 py-12">
      <div class="max-w-2xl w-full">
        <div class="text-center mb-3">
          <div class="text-xs font-bold text-navy-500 uppercase tracking-widest">Pergunta 3 de 5</div>
        </div>
        <div class="mb-8">
          <div class="h-1.5 bg-navy-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-teal-500 to-teal-600 transition-all duration-500" style="width:60%"></div>
          </div>
        </div>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-navy-900 leading-tight mb-3 text-center">
          O que <span class="text-red-600">mais te incomoda</span> hoje?
        </h2>
        <p class="text-base sm:text-lg text-navy-600 text-center mb-8">
          Marca a que mais bate com sua realidade
        </p>
        <div class="space-y-3">
          <button type="button" data-quiz-answer data-question="dor" data-value="sem_sobra" data-next="4" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-red-400 hover:bg-red-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl flex-shrink-0">😩</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Vendo bem mas nunca sobra nada</span>
              <span class="block text-xs text-navy-500 mt-1">no fim do mês, o que entrou já foi</span>
            </span>
          </button>
          <button type="button" data-quiz-answer data-question="dor" data-value="sem_clareza" data-next="4" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-red-400 hover:bg-red-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl flex-shrink-0">😵‍💫</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Não sei pra onde vai o dinheiro</span>
              <span class="block text-xs text-navy-500 mt-1">soma os boletos e não bate com o que rendeu</span>
            </span>
          </button>
          <button type="button" data-quiz-answer data-question="dor" data-value="muitas_horas" data-next="4" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-red-400 hover:bg-red-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl flex-shrink-0">⏳</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Trabalho 12+ horas e não consigo descansar</span>
              <span class="block text-xs text-navy-500 mt-1">tô preso ao negócio o tempo todo</span>
            </span>
          </button>
          <button type="button" data-quiz-answer data-question="dor" data-value="misto_pf_pj" data-next="4" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-red-400 hover:bg-red-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl flex-shrink-0">💳</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Misturo conta da empresa com a pessoal</span>
              <span class="block text-xs text-navy-500 mt-1">no fim das contas, não sei o que é meu</span>
            </span>
          </button>
        </div>
        <div class="text-center mt-8">
          <button type="button" data-quiz-back="2" class="text-sm text-navy-500 hover:text-navy-700 font-semibold">← Voltar</button>
        </div>
      </div>
    </section>

    <!-- ETAPA 4: JÁ TENTOU -->
    <section id="step-4" class="quiz-step hidden min-h-[100vh] flex items-center justify-center px-5 py-12">
      <div class="max-w-2xl w-full">
        <div class="text-center mb-3">
          <div class="text-xs font-bold text-navy-500 uppercase tracking-widest">Pergunta 4 de 5</div>
        </div>
        <div class="mb-8">
          <div class="h-1.5 bg-navy-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-teal-500 to-teal-600 transition-all duration-500" style="width:80%"></div>
          </div>
        </div>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-navy-900 leading-tight mb-3 text-center">
          Já tentou planilha,<br/>sistema ou contador?
        </h2>
        <p class="text-base sm:text-lg text-navy-600 text-center mb-8">
          Pra eu te dar o caminho certo
        </p>
        <div class="space-y-3">
          <button type="button" data-quiz-answer data-question="tentou" data-value="planilha_falhei" data-next="5" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl">📊</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Sim, tentei planilha — não consegui manter</span>
              <span class="block text-xs text-navy-500 mt-1">parei depois de uns dias</span>
            </span>
          </button>
          <button type="button" data-quiz-answer data-question="tentou" data-value="contador_nao_resolveu" data-next="5" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl">🧾</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Tenho contador — mas continuo no escuro</span>
              <span class="block text-xs text-navy-500 mt-1">só me dá os impostos no fim do mês</span>
            </span>
          </button>
          <button type="button" data-quiz-answer data-question="tentou" data-value="sistema_complicado" data-next="5" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl">💻</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Sistema/ERP — muito complicado pro meu tamanho</span>
              <span class="block text-xs text-navy-500 mt-1">virou só mais uma despesa</span>
            </span>
          </button>
          <button type="button" data-quiz-answer data-question="tentou" data-value="nunca" data-next="5" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl">🤷</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Nunca tentei nada estruturado</span>
              <span class="block text-xs text-navy-500 mt-1">toco na cabeça</span>
            </span>
          </button>
        </div>
        <div class="text-center mt-8">
          <button type="button" data-quiz-back="3" class="text-sm text-navy-500 hover:text-navy-700 font-semibold">← Voltar</button>
        </div>
      </div>
    </section>

    <!-- ETAPA 5: URGÊNCIA -->
    <section id="step-5" class="quiz-step hidden min-h-[100vh] flex items-center justify-center px-5 py-12">
      <div class="max-w-2xl w-full">
        <div class="text-center mb-3">
          <div class="text-xs font-bold text-navy-500 uppercase tracking-widest">Pergunta 5 de 5 · última!</div>
        </div>
        <div class="mb-8">
          <div class="h-1.5 bg-navy-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-teal-500 to-teal-600 transition-all duration-500" style="width:100%"></div>
          </div>
        </div>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-navy-900 leading-tight mb-3 text-center">
          Em <span class="text-teal-600">quanto tempo</span> você quer resolver isso?
        </h2>
        <p class="text-base sm:text-lg text-navy-600 text-center mb-8">
          Sinceramente. Pra eu te entregar o passo a passo certo.
        </p>
        <div class="space-y-3">
          <button type="button" data-quiz-answer data-question="urgencia" data-value="urgente" data-next="result" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-red-500 hover:bg-red-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl">🔥</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">URGENTE — tô apertado financeiramente</span>
              <span class="block text-xs text-navy-500 mt-1">preciso resolver agora</span>
            </span>
          </button>
          <button type="button" data-quiz-answer data-question="urgencia" data-value="mes" data-next="result" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl">⚡</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">Próximos 30 dias</span>
              <span class="block text-xs text-navy-500 mt-1">quero ver resultado já no próximo mês</span>
            </span>
          </button>
          <button type="button" data-quiz-answer data-question="urgencia" data-value="90dias" data-next="result" class="quiz-option w-full text-left flex items-center gap-4 bg-white border-2 border-navy-200 hover:border-teal-500 hover:bg-teal-50 rounded-2xl px-5 sm:px-6 py-4 transition-all cursor-pointer">
            <span class="text-3xl">🎯</span>
            <span class="flex-1">
              <span class="block font-bold text-navy-900 text-sm sm:text-base">90 dias — quero construir base sólida</span>
              <span class="block text-xs text-navy-500 mt-1">não tô apertado, mas quero virar o jogo</span>
            </span>
          </button>
        </div>
        <div class="text-center mt-8">
          <button type="button" data-quiz-back="4" class="text-sm text-navy-500 hover:text-navy-700 font-semibold">← Voltar</button>
        </div>
      </div>
    </section>

    <!-- ETAPA 6: PROCESSANDO -->
    <section id="step-loading" class="quiz-step hidden min-h-[100vh] flex items-center justify-center px-5 py-12">
      <div class="max-w-md text-center">
        <div class="relative inline-block mb-6">
          <div class="w-24 h-24 border-4 border-teal-200 border-t-teal-600 rounded-full animate-spin"></div>
          <div class="absolute inset-0 flex items-center justify-center text-3xl">💰</div>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-navy-900 leading-tight mb-3">
          Calculando seu diagnóstico...
        </h2>
