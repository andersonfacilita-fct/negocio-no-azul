---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
import ProblemAgitation from '../components/ProblemAgitation.astro';
import MethodAzul from '../components/MethodAzul.astro';
import WhatsIncluded from '../components/WhatsIncluded.astro';
import CaseStudy from '../components/CaseStudy.astro';
import ForWho from '../components/ForWho.astro';
import PriceOffer from '../components/PriceOffer.astro';
import FAQ from '../components/FAQ.astro';
import About from '../components/About.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
---

<Layout
  title="Negócio no Azul - Descubra o vazamento de dinheiro do seu negócio em 7 dias | R$ 47"
  description="Mesmo vendendo bem, o dinheiro nunca sobra? Em 7 dias você descobre exatamente para onde está vazando - e começa a lucrar. Cartilha + Planilha + Guia por R$ 47."
>
  <main>
    <Hero />
    <VideoShowcase />
    <ProblemAgitation />
    <MethodAzul />
    <WhatsIncluded />
    <CaseStudy />
    <ForWho />
    <PriceOffer />
    <FAQ />
    <About />
    <FinalCTA />
  </main>
  <Footer />
  <StickyMobileCTA />
</Layout>
