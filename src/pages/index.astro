---
// Estrutura "Página de Vendas 3x" (método Maxxima) — 14 blocos.
// Botão de compra SÓ nos blocos 9 e 12. Bloco 2 (Depoimentos) removido: sem prova social real
// (o método manda remover quando não há lastro). Sem números agregados/caso fictício (decisão 11/06).
import Layout from '../layouts/Layout.astro';
import BuyButton from '../components/BuyButton.astro';
import Icon from '../components/Icon.astro';

const PRECO = 'R$ 67';
const ANCORA = 'R$ 197';
---

<Layout
  title="Protocolo do Negócio no Azul em 7 Dias — Descubra pra onde seu dinheiro vaza | R$ 67"
  description="Vende bem mas o dinheiro nunca sobra? Em 7 dias o nosso protocolo mostra exatamente pra onde seu dinheiro vaza — e você começa a lucrar sem vender mais. Cartilha + Planilha + Guia por R$ 67."
>
  <main class="overflow-x-hidden">
    <!-- ===================================================================== -->
    <!-- BLOCO 1 · VENDER SOZINHO (Hero) — bater o olho e querer comprar        -->
    <!-- ===================================================================== -->
    <section class="relative gradient-navy text-white">
      <div class="pointer-events-none absolute inset-0 opacity-25">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-teal-500 blur-3xl"></div>
        <div class="absolute bottom-0 -left-24 h-80 w-80 rounded-full bg-gold-400/50 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-6xl px-5 pb-12 pt-8 sm:pt-12 lg:pb-20 lg:pt-16">
        <div class="mb-5 flex justify-center px-2">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-center text-sm font-semibold text-white ring-1 ring-white/15 backdrop-blur sm:text-base">
            <span class="relative flex h-2.5 w-2.5 flex-shrink-0">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-gold-400 opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-gold-400"></span>
            </span>
            Vende bem, mas o dinheiro some?
          </p>
        </div>
        <h1 class="mx-auto max-w-4xl text-center font-display text-[30px] font-extrabold leading-[1.06] sm:text-5xl lg:text-6xl">
          Vende bem, mas o dinheiro <span class="text-gradient-teal">vaza</span><br class="hidden sm:block" /> e você não sabe por onde?
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-center text-base leading-relaxed text-navy-100 sm:text-xl">
          Em <strong class="text-teal-300">7 dias</strong> você descobre <strong class="text-white">exatamente</strong> pra onde seu dinheiro está indo — e começa a sobrar dinheiro no fim do mês <strong class="text-gold-400">sem precisar vender mais</strong>. Sem planilha complicada, sem teoria de faculdade, sem virar economista.
        </p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-navy-200 sm:text-sm">
          <span class="inline-flex items-center gap-1.5"><Icon name="bolt" class="h-4 w-4 text-teal-300" />Acesso imediato</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="wallet" class="h-4 w-4 text-teal-300" />Pagamento único, sem mensalidade</span>
        </div>

        <!-- Banner comparativo (dor): vende bem o mês inteiro, mas no fim não sobra nada — arte fornecida -->
        <figure class="relative mx-auto mt-10 max-w-4xl sm:mt-12">
          <div class="pointer-events-none absolute -inset-2 bg-gradient-to-tr from-teal-500/20 to-gold-400/20 blur-2xl"></div>
          <img
            src="/hero-vende-bem.webp"
            alt="De um lado, o dono feliz contando o dinheiro que entra o mês inteiro; do outro, o mesmo dono de cabeça baixa com a conta zerada e os boletos acumulados no fim do mês. O problema não é vender pouco — é não enxergar para onde o dinheiro está vazando."
            width="1672"
            height="941"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="relative w-full rounded-2xl shadow-2xl ring-1 ring-white/10"
          />
        </figure>

        <!-- Mockup do produto (cartilha + planilha) — sem botão de compra no hero (regra Maxxima) -->
        <div class="relative mx-auto mt-12 max-w-md sm:mt-14">
          <div class="absolute inset-0 bg-gradient-to-tr from-teal-500/25 to-gold-400/25 blur-3xl"></div>
          <div class="relative flex items-end justify-center">
            <!-- Capa cartilha -->
            <div class="relative w-52 sm:w-64 aspect-[3/4] rounded-2xl bg-gradient-to-br from-navy-700 via-navy-800 to-navy-950 shadow-2xl ring-1 ring-teal-500/20 rotate-[-6deg] overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-tr from-teal-500/10 via-transparent to-gold-400/10"></div>
              <div class="relative flex h-full flex-col justify-between p-6 sm:p-8">
                <div>
                  <div class="text-[10px] font-bold uppercase tracking-widest text-teal-300 sm:text-xs">Protocolo · Cartilha + Planilha + Guia</div>
                  <div class="my-4 h-0.5 w-10 bg-gold-400"></div>
                  <h3 class="font-display text-2xl font-extrabold leading-tight text-white sm:text-3xl">Negócio<br /><span class="text-gradient-teal">no Azul</span></h3>
                  <p class="mt-2 text-xs font-bold uppercase tracking-wide text-gold-400 sm:text-sm">em 7 dias</p>
                  <p class="mt-3 text-[11px] leading-relaxed text-navy-200 sm:text-sm">Do caos ao controle com o nosso protocolo.</p>
                </div>
                <div class="text-[11px] font-bold text-navy-200 sm:text-sm">por Anderson Cruz</div>
              </div>
            </div>
            <!-- Card planilha -->
            <div class="relative -ml-8 w-36 sm:w-44 aspect-[4/5] rounded-xl bg-white shadow-2xl rotate-[7deg] ring-2 ring-teal-500 overflow-hidden">
              <div class="flex h-7 items-center gap-1.5 bg-teal-600 px-3">
                <div class="h-2 w-2 rounded-full bg-white/70"></div>
                <div class="h-2 w-2 rounded-full bg-white/50"></div>
                <div class="ml-auto text-[9px] font-bold uppercase tracking-wide text-white">Planilha</div>
              </div>
              <div class="space-y-1 p-2.5">
                {[...Array(5)].map((_, i) => (
                  <div class="grid grid-cols-3 gap-1">
                    <div class={`h-2 rounded ${i === 0 ? 'bg-navy-800' : 'bg-navy-100'}`}></div>
                    <div class={`h-2 rounded ${i === 0 ? 'bg-navy-800' : 'bg-teal-200'}`}></div>
                    <div class={`h-2 rounded ${i === 0 ? 'bg-navy-800' : i === 2 ? 'bg-gold-300' : 'bg-teal-400'}`}></div>
                  </div>
                ))}
                <div class="mt-2 border-t border-navy-100 pt-2">
                  <div class="text-[9px] font-bold uppercase text-teal-700">Lucro real</div>
                  <div class="font-display text-base font-extrabold text-teal-600">+ no azul</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA de compra no hero (bloco 1) -->
        <div class="mx-auto mt-10 max-w-md">
          <BuyButton size="xl" />
        </div>

        <div class="mt-8 flex flex-col items-center gap-1 text-navy-200">
          <span class="text-xs font-semibold uppercase tracking-widest">Veja como funciona</span>
          <svg class="h-6 w-6 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </div>
      </div>
    </section>

    <!-- BLOCO 2 · DEPOIMENTOS — removido: sem prova social real (decisão 11/06, espelho da vendedoria).
         Método Maxxima manda omitir prova sem lastro (risco Hotmart/Procon). Recolocar quando houver caso real documentado. -->

    <!-- ===================================================================== -->
    <!-- BLOCO 3 · DOR LATENTE PRINCIPAL (ruminação) — gerar identificação      -->
    <!-- ===================================================================== -->
    <section class="bg-white py-14 sm:py-20">
      <div class="mx-auto max-w-3xl px-5">
        <h2 class="text-center font-display text-2xl font-extrabold leading-tight text-navy-900 sm:text-4xl">
          O problema quase nunca é vender. <span class="text-red-600">É o dinheiro que some depois.</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-center text-base text-navy-600 sm:text-lg">
          Se um desses pensamentos passou pela sua cabeça esse mês, esta página é pra você.
        </p>
        <!-- Arte: empreendedora cercada dos pensamentos da dor — substitui a antiga lista de balões em texto (mesmo conteúdo, mais visual) -->
        <figure class="mx-auto mt-9 max-w-3xl">
          <img
            src="/problema-pensamentos.webp"
            alt="Empreendedora pensativa na mesa, cercada de balões de pensamento: 'entra Pix e passa maquininha, mas no fim do mês o dinheiro evapora'; 'misturo meu dinheiro com o da empresa e já não sei o que é lucro, dívida ou bagunça'; 'pago fornecedor, imposto, aluguel e funcionário e quando chega minha vez não sobra nada'; 'não sei se meu preço dá lucro, tenho medo de estar vendendo no prejuízo'; 'por fora parece tudo bem, por dentro vivo apagando incêndio e torcendo pra fechar no azul'."
            width="1448"
            height="1086"
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl shadow-sm ring-1 ring-navy-100"
          />
        </figure>
        <div class="mt-9 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {[
            { n: '3 números', d: 'decidem se você lucra ou não: ponto de equilíbrio, pró-labore e maior ralo' },
            { n: '15 min/dia', d: 'é tudo que separa o dono no controle, do dono no escuro' },
            { n: '7 dias', d: 'pra enxergar pra onde cada real do seu negócio está indo' },
          ].map((s) => (
            <div class="rounded-2xl bg-red-50 p-5 text-center ring-1 ring-red-100">
              <div class="font-display text-2xl font-extrabold text-red-600 sm:text-3xl">{s.n}</div>
              <div class="mt-1 text-sm text-red-900/70">{s.d}</div>
            </div>
          ))}
        </div>
        <p class="mx-auto mt-8 max-w-2xl text-center font-display text-xl font-extrabold text-navy-900 sm:text-2xl">
          O pior não é perder um cliente. É ver o lucro vazar todo mês — <span class="text-red-600">sem nem perceber.</span>
        </p>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCO 4 · TRANSIÇÃO DA DOR PRA SOLUÇÃO — abrir a porta (o nosso protocolo · 4 passos A/Z/U/L) -->
    <!-- ===================================================================== -->
    <section class="bg-gradient-to-b from-navy-50 via-teal-50/40 to-white py-14 sm:py-20">
      <div class="mx-auto max-w-5xl px-5">
        <div class="mx-auto max-w-2xl text-center">
          <span class="inline-block rounded-full bg-teal-500/15 px-3 py-1 text-xs font-bold uppercase tracking-widest text-teal-700">A virada</span>
          <h2 class="mt-4 font-display text-2xl font-extrabold leading-tight text-navy-900 sm:text-4xl">
            E se em 7 dias você soubesse <span class="text-gradient-teal">exatamente pra onde vai cada real?</span>
          </h2>
          <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-navy-700 sm:text-lg">
            Não é vender mais. É parar de perder o que você já ganha. O <strong class="text-navy-900">nosso protocolo</strong> tem 4 passos simples — linguagem de feira, não de faculdade — que você aplica no celular, 15 minutos por dia.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { letter: 'A', icon: 'doc', title: 'Anotar', sub: 'toda entrada e saída', desc: 'O que você não mede, você não controla. 15 minutos por dia — como escovar os dentes do seu negócio.' },
            { letter: 'Z', icon: 'drop', title: 'Zerar ralos', sub: 'achar os desperdícios invisíveis', desc: 'Aqueles R$ 300, R$ 500, R$ 1.200 que somem todo mês sem você ver — descobertos e travados na raiz.' },
            { letter: 'U', icon: 'scale', title: 'Unificar separando', sub: 'PF e PJ separados, pró-labore fixo', desc: 'Fim da bagunça: uma conta pra vida pessoal, outra pro negócio e um salário fixo pra você.' },
            { letter: 'L', icon: 'coins', title: 'Lucrar com consciência', sub: 'lucro com destino', desc: 'Lucro não é o que sobra sem querer. É dinheiro com destino certo: uma parte pra reserva, uma pra crescer e uma pra você — você decide quanto vai pra cada uma.' },
          ].map((s) => (
            <div class="relative overflow-hidden rounded-2xl border border-navy-100 bg-white p-6 shadow-sm">
              <div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-gradient-to-br from-teal-400 to-teal-700 opacity-10"></div>
              <div class="relative flex items-center gap-3">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-teal-500 to-teal-700 font-display text-2xl font-extrabold text-white shadow-md">{s.letter}</div>
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-teal-50 text-teal-600"><Icon name={s.icon} class="h-5 w-5" /></div>
              </div>
              <h3 class="mt-4 font-display text-lg font-extrabold text-navy-900">{s.title}</h3>
              <p class="text-xs font-semibold uppercase tracking-wide text-teal-600">{s.sub}</p>
              <p class="mt-2 text-sm leading-relaxed text-navy-700">{s.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-9 text-center">
          <p class="inline-flex items-center gap-2 rounded-full border border-gold-400/40 bg-gold-400/15 px-5 py-3 font-display text-sm font-bold text-navy-900 sm:text-base">
            <Icon name="check" class="h-5 w-5 text-gold-500" />
            Em 7 dias você sabe seus 3 números: Ponto de Equilíbrio, Pró-labore ideal e Maior Ralo.
          </p>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCO 5 · AGORA VOCÊ VAI — benefícios na prática (4 a 6)               -->
    <!-- ===================================================================== -->
    <section class="bg-white py-14 sm:py-20">
      <div class="mx-auto max-w-4xl px-5">
        <h2 class="text-center font-display text-2xl font-extrabold text-navy-900 sm:text-4xl">Com o Protocolo Negócio no Azul, você vai:</h2>
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {[
            { i: 'chart', t: 'Saber seu lucro real', d: 'Não o que entra no caixa — o que de fato sobra pra você no fim do mês.' },
            { i: 'search', t: 'Achar pra onde o dinheiro vaza', d: 'Os ralos invisíveis que comem R$ 300, R$ 500, R$ 1.200 todo mês — e travar na raiz.' },
            { i: 'scale', t: 'Separar você da empresa', d: 'Fim da mistura PF/PJ. Um salário fixo pra você e clareza no caixa do negócio.' },
            { i: 'tag', t: 'Saber se seu preço está certo', d: 'Pare de vender no escuro: descubra se cada venda dá lucro ou prejuízo.' },
            { i: 'target', t: 'Decidir com número, não no feeling', d: 'Ponto de equilíbrio na mão: você sabe quanto precisa vender pra não ficar no vermelho.' },
            { i: 'coins', t: 'Fazer o dinheiro sobrar sem vender mais', d: 'Mesma venda, mais lucro no bolso — só organizando o que já existe.' },
          ].map((c) => (
            <div class="flex items-start gap-4 rounded-2xl bg-navy-50 p-5">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-white text-teal-600 shadow-sm"><Icon name={c.i} class="h-6 w-6" /></div>
              <div><div class="font-display text-lg font-extrabold text-navy-900">{c.t}</div><div class="mt-1 text-sm text-navy-600">{c.d}</div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCO 6 · TUDO QUE VOCÊ VAI RECEBER + BÔNUS                            -->
    <!-- ===================================================================== -->
    <section class="gradient-navy py-14 text-white sm:py-20">
      <div class="mx-auto max-w-3xl px-5">
        <h2 class="text-center font-display text-2xl font-extrabold sm:text-4xl">Tudo que você leva</h2>
        <p class="mx-auto mt-3 max-w-xl text-center text-base text-navy-200 sm:text-lg">Um pacote completo pra sair do caos financeiro — sem você ter que virar economista.</p>
        <div class="mx-auto mt-9 max-w-2xl space-y-3">
          {[
            { i: 'doc', t: 'Cartilha do nosso protocolo (22 págs)', d: 'o nosso protocolo completo, com plano de 7 dias passo a passo, em linguagem direta' },
            { i: 'grid', t: 'Planilha Financeira automática (8 abas)', d: 'você só lança entrada e saída; ela faz DRE, diagnóstico, ponto de equilíbrio e alertas' },
            { i: 'doc', t: 'Guia de Uso da planilha (14 págs)', d: 'aba por aba, com exemplos preenchidos — você não precisa saber Excel' },
          ].map((it) => (
            <div class="flex items-center gap-4 rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-teal-500 text-white"><Icon name={it.i} class="h-5 w-5" /></span>
              <div class="flex-1"><div class="font-bold">{it.t}</div><div class="text-sm text-navy-200">{it.d}</div></div>
            </div>
          ))}
          <div class="pt-2 text-center text-xs font-bold uppercase tracking-widest text-gold-400">+ Bônus exclusivo</div>
          <div class="flex items-center gap-4 rounded-2xl bg-gold-400/10 p-4 ring-1 ring-gold-400/25">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-gold-400 text-navy-900"><Icon name="spark" class="h-5 w-5" /></span>
            <div class="flex-1"><div class="font-bold">Bônus: Grupo VIP no WhatsApp</div><div class="text-sm text-navy-200">comunidade pra tirar dúvida sobre o protocolo e trocar ideia com outros empreendedores — o link chega no seu e-mail</div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCO 7 · PARA QUEM SERVE — "é pra mim"                                -->
    <!-- ===================================================================== -->
    <section class="bg-white py-14 sm:py-20">
      <div class="mx-auto max-w-5xl px-5">
        <h2 class="text-center font-display text-2xl font-extrabold text-navy-900 sm:text-4xl">Isso é pra você?</h2>
        <div class="mt-9 grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="rounded-2xl border-2 border-teal-500/30 bg-teal-50/60 p-6">
            <div class="mb-4 flex items-center gap-2 font-display text-lg font-extrabold text-teal-800"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-teal-500 text-white"><Icon name="check" class="h-4 w-4" /></span>É pra você se…</div>
            <ul class="space-y-2.5 text-navy-800">
              {[
                'Tem um pequeno negócio ou é autônomo/MEI e fatura de R$ 3 mil a R$ 100 mil/mês',
                'Vende bem mas no fim do mês nunca sobra dinheiro — e não sabe por quê',
                'Mistura o dinheiro pessoal com o da empresa e quer separar de vez',
                'Quer decidir com número, não no feeling',
                'Tem 15 minutos por dia e não quer virar economista',
              ].map((t) => (
                <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 h-5 w-5 flex-shrink-0 text-teal-600" /><span>{t}</span></li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl border-2 border-red-200 bg-red-50 p-6">
            <div class="mb-4 flex items-center gap-2 font-display text-lg font-extrabold text-red-700"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-red-500 text-white"><Icon name="x" class="h-4 w-4" /></span>Não é pra você se…</div>
            <ul class="space-y-2.5 text-red-900/80">
              {[
                'Procura fórmula mágica pra ficar rico sem mexer no que faz',
                'Não topa anotar entrada e saída por alguns minutos no dia',
                'Acha que controle financeiro é só pra empresa grande',
                'Quer um contador pra terceirizar e nunca olhar os números',
                'Não tem nenhuma entrada e saída de dinheiro pra organizar',
              ].map((t) => (
                <li class="flex items-start gap-2.5"><Icon name="x" class="mt-0.5 h-5 w-5 flex-shrink-0 text-red-500" /><span>{t}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCO 8 · ANCORAGEM COM PREÇO — quanto vale tudo isso                  -->
    <!-- ===================================================================== -->
    <section class="bg-gradient-to-b from-navy-50 via-teal-50/40 to-white py-14 sm:py-20">
      <div class="mx-auto max-w-2xl px-5">
        <p class="text-center text-xs font-bold uppercase tracking-widest text-teal-700">Recapitulando, tudo que você recebe</p>
        <div class="mt-6 rounded-3xl bg-white p-7 shadow-sm ring-1 ring-teal-500/10 sm:p-9">
          <ul class="space-y-3">
            {[
              { t: 'Cartilha do nosso protocolo (22 págs)', v: 'R$ 67' },
              { t: 'Planilha Financeira automática (8 abas)', v: 'R$ 87' },
              { t: 'Guia de Uso passo a passo (14 págs)', v: 'R$ 43' },
            ].map((it) => (
              <li class="flex items-center justify-between gap-3 border-b border-teal-500/10 pb-3 text-navy-900">
                <span class="flex items-center gap-2.5"><Icon name="check" class="h-5 w-5 flex-shrink-0 text-teal-600" />{it.t}</span>
                <span class="text-sm text-navy-400 line-through">{it.v}</span>
              </li>
            ))}
            <li class="flex items-center justify-between gap-3 pb-1 text-navy-900">
              <span class="flex items-center gap-2.5"><Icon name="spark" class="h-5 w-5 flex-shrink-0 text-gold-500" />Bônus: Grupo VIP no WhatsApp</span>
              <span class="text-xs font-bold uppercase tracking-wide text-teal-600">Grátis</span>
            </li>
          </ul>
          <p class="mt-6 text-center font-display text-xl font-extrabold text-navy-900 sm:text-2xl">
            Tudo isso deveria custar <span class="text-red-600 line-through">{ANCORA}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCO 9 · VALOR — BOTÃO DE COMPRA #1                                   -->
    <!-- ===================================================================== -->
    <section id="oferta" class="bg-white py-14 sm:py-20">
      <div class="mx-auto max-w-2xl px-5">
        <div class="text-center">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-teal-700">Mas hoje, com tudo junto, por apenas</span>
        </div>
        <div class="relative mt-6 rounded-3xl border-4 border-gold-400 bg-gradient-to-br from-white to-teal-50/50 p-7 shadow-2xl sm:p-9">
